{
  "name": "@nghien-ot/rux",
  "type": "module",
  "description": "A declarative, type-safe HTTP client for TypeScript with zero runtime dependencies.",
  "keywords": [
    "http",
    "client",
    "typescript",
    "declarative",
    "type-safe",
    "zero-runtime-dependencies"
  ],
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nghien-ot/rux.git"
  },
  "bugs": {
    "url": "https://github.com/nghien-ot/rux/issues"
  },
  "homepage": "https://github.com/nghien-ot/rux#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vite build && vitest run --typecheck",
    "test:watch": "vite build && vitest --typecheck --exclude tests/package.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@typescript/typescript6": "^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {}
}
